#!/usr/bin/env bash
# groundup session-start hook
# Injects the using-groundup bootstrap skill into every session,
# followed by any in-progress session state and project-level overrides.
# Outputs JSON with hookEventName + additionalContext as required by Claude Code.

set -euo pipefail

SKILL_FILE="${CLAUDE_PLUGIN_ROOT}/skills/using-groundup/SKILL.md"

if [[ ! -f "$SKILL_FILE" ]]; then
  exit 0
fi

# Build up the context block in a temp variable
context=""

context+=$(cat "$SKILL_FILE")

# If a session is in progress, surface the state so Claude can resume rather
# than restart. Only shown when phase is not "complete".
STATE_FILE=".groundup/session-state.json"
if [[ -f "$STATE_FILE" ]]; then
  phase=$(python3 -c "import json,sys; d=json.load(open('$STATE_FILE')); print(d.get('phase',''))" 2>/dev/null || true)
  if [[ -n "$phase" && "$phase" != "complete" ]]; then
    context+=$'\n\n---\n# Resuming In-Progress Session\n\nA groundup session is already in progress for this project.\nRead .groundup/session-state.json and resume from the recorded phase.\nDo NOT restart the process — continue from where the engineer left off.\n\n'
    context+=$(cat "$STATE_FILE")
  fi
fi

# Surface the last 10 entries from the global growth log so the mentor can
# adapt gate depth before the session begins.
GROWTH_LOG="${HOME}/.claude/groundup/growth-log.md"
if [[ -f "$GROWTH_LOG" ]]; then
  growth_entries=$(python3 - "$GROWTH_LOG" <<'PYEOF' 2>/dev/null || tail -100 "$GROWTH_LOG"
import sys, re

with open(sys.argv[1]) as f:
    content = f.read()

sections = re.split(r'(?=^## )', content, flags=re.MULTILINE)
sections = [s.strip() for s in sections if s.strip().startswith('## ')]

for section in sections[-10:]:
    print(section)
    print()
PYEOF
)
  context+=$'\n\n---\n# Engineer Growth History (last 10 entries)\n\nRead these entries and calibrate your approach before this session begins.\nRecurring traps → increase probe depth. Consistent wins → reduce scaffolding.\n\n'
  context+="$growth_entries"
fi

# If the project has a .grounduprc.md, append it so team-specific rules
# override or extend the defaults for this session.
if [[ -f ".grounduprc.md" ]]; then
  context+=$'\n\n---\n# Project Overrides (.grounduprc.md)\n\n'
  context+=$(cat ".grounduprc.md")
fi

# Output JSON as required by Claude Code SessionStart hooks
python3 -c "
import json, sys
context = sys.stdin.read()
print(json.dumps({
    'hookEventName': 'SessionStart',
    'additionalContext': context
}))
" <<< "$context"
